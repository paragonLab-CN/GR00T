"""
Generate K explicit-initial-noise GR00T action candidates from fixed
offline LeRobot observations.

The GR00T-N1.7-LIBERO model internally denoises a universal action tensor of
shape [B, 40, 132]. ``--action-horizon`` controls how many decoded LIBERO
action steps are kept (for example 8); it does not change the initial-noise
shape.

Example:
uv run python scripts/flare/generate_k_candidates_openloop.py \
  --model-path checkpoints/GR00T-N1.7-LIBERO/libero_10 \
  --dataset-path demo_data/libero_demo \
  --embodiment-tag LIBERO_PANDA \
  --traj-ids 0 \
  --steps 24 \
  --inference-mode pytorch \
  --action-horizon 8 \
  --sample-stride 8 \
  --candidate-k 4 \
  --noise-mode independent \
  --noise-base-seed 2026 \
  --candidate-save-dir outputs/flare_openloop_candidates_test \
  --no-get-performance-stats
"""

