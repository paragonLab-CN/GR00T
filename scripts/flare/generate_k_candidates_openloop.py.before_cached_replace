def _infer_batch_size(observation: dict[str, Any]) -> int:
    """Infer B from one parsed GR00T observation without assuming a key name."""
    for modality_value in observation.values():
        values = modality_value.values() if isinstance(modality_value, dict) else [modality_value]
        for value in values:
            if torch.is_tensor(value) or isinstance(value, np.ndarray):
                if value.ndim >= 1:
                    return int(value.shape[0])
            elif isinstance(value, list) and value:
                return len(value)
    raise ValueError("Could not infer batch size from parsed observation")


def _get_internal_noise_shape(policy: BasePolicy, batch_size: int) -> tuple[int, int, int]:
    """Return [B, model_H, internal_D] required by the PyTorch action head."""
    model = getattr(policy, "model", None)
    action_head = getattr(model, "action_head", None)
    if action_head is None:
        raise TypeError(
            "Explicit initial_noise currently requires PyTorch Gr00tPolicy with "
            "policy.model.action_head available"
        )

    model_horizon = int(action_head.config.action_horizon)
    internal_action_dim = int(action_head.action_dim)
    return batch_size, model_horizon, internal_action_dim


def _normal_noise(shape: tuple[int, ...], seed: int) -> torch.Tensor:
    """Draw reproducible CPU Gaussian noise without changing global RNG state."""
    generator = torch.Generator(device="cpu")
    generator.manual_seed(int(seed))
    return torch.randn(shape, generator=generator, dtype=torch.float32)


def build_explicit_initial_noises(
    shape: tuple[int, int, int],
    candidate_k: int,
    sample_seed: int,
    noise_mode: str,
    noise_scale: float,
) -> tuple[torch.Tensor, list[int], int | None]:
    """Create [B,K,model_H,internal_D] explicit initial-noise candidates.

    Modes:
      independent: epsilon_k = scale * N_k(0, I)
      perturb:     epsilon_0 = base; epsilon_k =
                   (base + scale * delta_k) / sqrt(1 + scale^2), k>0
                   The denominator preserves unit marginal variance.
    """
    if candidate_k < 1:
        raise ValueError(f"candidate_k must be >= 1, got {candidate_k}")
    if noise_scale < 0:
        raise ValueError(f"noise_scale must be >= 0, got {noise_scale}")
    if noise_mode not in {"independent", "perturb"}:
        raise ValueError(f"Unsupported noise_mode={noise_mode!r}")

    candidate_seeds: list[int] = []
    noises: list[torch.Tensor] = []
    base_seed: int | None = None

    if noise_mode == "independent":
        for candidate_idx in range(candidate_k):
            seed = int(sample_seed) + candidate_idx
            candidate_seeds.append(seed)
            noises.append(_normal_noise(shape, seed) * float(noise_scale))
    else:
        base_seed = int(sample_seed)
        base = _normal_noise(shape, base_seed)
        noises.append(base.clone())
        candidate_seeds.append(base_seed)
        denominator = float(np.sqrt(1.0 + noise_scale**2))
        for candidate_idx in range(1, candidate_k):
            delta_seed = int(sample_seed) + candidate_idx
            delta = _normal_noise(shape, delta_seed)
            noises.append((base + float(noise_scale) * delta) / denominator)
            candidate_seeds.append(delta_seed)

    return torch.stack(noises, dim=1), candidate_seeds, base_seed


def _to_saveable_cpu(value: Any) -> Any:
    """Recursively convert tensors/arrays to independent CPU save objects."""
    if torch.is_tensor(value):
        return value.detach().cpu().clone()
    if isinstance(value, np.ndarray):
        if value.dtype == object:
            return [_to_saveable_cpu(v) for v in value.tolist()]
        return torch.from_numpy(np.array(value, copy=True))
    if isinstance(value, dict):
        return {k: _to_saveable_cpu(v) for k, v in value.items()}
    if isinstance(value, list):
        return [_to_saveable_cpu(v) for v in value]
    if isinstance(value, tuple):
        return tuple(_to_saveable_cpu(v) for v in value)
    if isinstance(value, np.generic):
        return value.item()
    if isinstance(value, (str, int, float, bool)) or value is None:
        return value
    return repr(value)


def _stack_candidate_actions(
    candidates: list[dict[str, np.ndarray]],
    action_keys: list[str],
    action_horizon: int,
) -> tuple[dict[str, np.ndarray], np.ndarray]:
    """Stack decoded fields as [B,K,H,D_key] and concatenate to [B,K,H,D]."""
    if not candidates:
        raise ValueError("No candidate actions were generated")

    stacked_fields: dict[str, np.ndarray] = {}
    concat_fields: list[np.ndarray] = []
    for key in action_keys:
        values: list[np.ndarray] = []
        for candidate_idx, candidate in enumerate(candidates):
            if key not in candidate:
                raise KeyError(
                    f"Action key {key!r} missing from candidate {candidate_idx}; "
                    f"available keys={list(candidate)}"
                )
            arr = np.asarray(candidate[key], dtype=np.float32)
            if arr.ndim != 3:
                raise ValueError(f"Expected action[{key!r}] [B,T,D], got {arr.shape}")
            if arr.shape[1] < action_horizon:
                raise ValueError(
                    f"Decoded action horizon {arr.shape[1]} is shorter than requested "
                    f"action_horizon={action_horizon}"
                )
            values.append(arr[:, :action_horizon].copy())

        field = np.stack(values, axis=1)
        stacked_fields[key] = field
        concat_fields.append(field)

    concatenated = np.concatenate(concat_fields, axis=-1).astype(np.float32, copy=False)
    return stacked_fields, concatenated


def _extract_gt_action_chunk(
    traj: pd.DataFrame,
    step_count: int,
    action_keys: list[str],
    action_horizon: int,
) -> tuple[dict[str, np.ndarray], np.ndarray]:
    """Read the aligned H-step dataset action chunk starting at step_count."""
    end = step_count + action_horizon
    if end > len(traj):
        raise IndexError(f"GT chunk [{step_count}:{end}] exceeds trajectory length {len(traj)}")

    fields: dict[str, np.ndarray] = {}
    concat_fields: list[np.ndarray] = []
    for key in action_keys:
        column = f"action.{key}"
        if column not in traj.columns:
            raise KeyError(f"Missing {column!r} in trajectory")
        values = [
            np.atleast_1d(np.asarray(v, dtype=np.float32))
            for v in traj[column].iloc[step_count:end]
        ]
        field = np.stack(values, axis=0)
        fields[key] = field
        concat_fields.append(field)

    concatenated = np.concatenate(concat_fields, axis=-1).astype(np.float32, copy=False)
    return fields, concatenated


def _row_metadata(traj: pd.DataFrame, step_count: int) -> dict[str, Any]:
    metadata: dict[str, Any] = {}
    for column in ("index", "episode_index", "frame_index", "timestamp", "task_index"):
        if column in traj.columns:
            value = traj.iloc[step_count][column]
            metadata[column] = value.item() if isinstance(value, np.generic) else value
    return metadata


class TensorRTDiTWrapper:
    """Wrapper for TensorRT DiT engine."""

    def __init__(self, engine_path: str, device: int = 0):
        import tensorrt as trt

        self.device = device

        # Ensures CUDA driver is properly loaded
        if torch.cuda.is_available():
            torch.cuda.init()
            torch.cuda.set_device(device)  # Set the specified CUDA device
            logging.info(f"CUDA initialized via PyTorch: device {device}")
        else:
            raise RuntimeError("CUDA not available for TensorRT")

        self.trt_logger = trt.Logger(trt.Logger.WARNING)
        self.runtime = trt.Runtime(self.trt_logger)

        with open(engine_path, "rb") as f:
            self.engine = self.runtime.deserialize_cuda_engine(f.read())

        if self.engine is None:
            raise RuntimeError(f"Failed to load TensorRT engine from {engine_path}")

        self.context = self.engine.create_execution_context()
        logging.info(f"TensorRT engine loaded: {engine_path}")

    def __call__(self, sa_embs, vl_embs, timestep, image_mask=None, backbone_attention_mask=None):
        """Forward pass through TensorRT DiT."""
        # Setup context bindings
        sa_embs = sa_embs.to(f"cuda:{self.device}").contiguous()
        vl_embs = vl_embs.to(f"cuda:{self.device}").contiguous()
        timestep = timestep.to(f"cuda:{self.device}").contiguous()  # Keep as int64

        if image_mask is not None:
            image_mask = image_mask.to(f"cuda:{self.device}").contiguous()
        if backbone_attention_mask is not None:
            backbone_attention_mask = backbone_attention_mask.to(f"cuda:{self.device}").contiguous()

        self.context.set_input_shape("sa_embs", sa_embs.shape)
        self.context.set_input_shape("vl_embs", vl_embs.shape)
        self.context.set_input_shape("timestep", timestep.shape)
        if image_mask is not None:
            self.context.set_input_shape("image_mask", image_mask.shape)
        if backbone_attention_mask is not None:
            self.context.set_input_shape("backbone_attention_mask", backbone_attention_mask.shape)

        self.context.set_tensor_address("sa_embs", sa_embs.data_ptr())
        self.context.set_tensor_address("vl_embs", vl_embs.data_ptr())
        self.context.set_tensor_address("timestep", timestep.data_ptr())
        if image_mask is not None:
            self.context.set_tensor_address("image_mask", image_mask.data_ptr())
        if backbone_attention_mask is not None:
            self.context.set_tensor_address(
                "backbone_attention_mask", backbone_attention_mask.data_ptr()
            )

        # Output in BF16 (matches ONNX export and engine precision)
        output_shape = self.context.get_tensor_shape("output")
        output = torch.empty(
            tuple(output_shape), dtype=torch.bfloat16, device=f"cuda:{self.device}"
        )
        self.context.set_tensor_address("output", output.data_ptr())

        success = self.context.execute_async_v3(torch.cuda.current_stream().cuda_stream)
        if not success:
            raise RuntimeError("TensorRT inference failed")

        return output


def replace_dit_with_tensorrt(policy: Gr00tPolicy | Any, trt_engine_path: str, device: int = 0):
    """Replace the DiT forward method with TensorRT inference."""
    trt_dit = TensorRTDiTWrapper(trt_engine_path, device=device)

    def trt_forward(
        hidden_states,
        encoder_hidden_states,
        timestep,
        encoder_attention_mask=None,
        return_all_hidden_states=False,
        image_mask=None,
        backbone_attention_mask=None,
    ):
        """
        TensorRT wrapper matching DiT forward signature.

        Maps DiT parameter names to ONNX export names:
        - hidden_states -> sa_embs
        - encoder_hidden_states -> vl_embs
        - timestep -> timestep
        - image_mask, backbone_attention_mask passed through
        """
        output = trt_dit(
            sa_embs=hidden_states,
            vl_embs=encoder_hidden_states,
            timestep=timestep,
            image_mask=image_mask,
            backbone_attention_mask=backbone_attention_mask,
        )

        # DiT returns (output, all_hidden_states) when return_all_hidden_states=True
        if return_all_hidden_states:
            # TensorRT only returns the final output, not intermediate states
            # For inference, we don't need intermediate states, so raise
            # as this seems invalid config for inference
            raise RuntimeError("TensorRT only returns the final output. Check inference config")
        else:
            return output

    policy.model.action_head.model.forward = trt_forward
    logging.info(" DiT replaced with TensorRT engine")


